# Required when config/platform.yaml sets security.auth to "bearer".
PLATFORM_API_KEY=

# Runtime overrides (optional; config/platform.yaml holds the defaults).
PLATFORM_PORT=3000
ENGINE_BACKEND="cpu"
ENGINE_URL="http://engine:8080"
MODEL_DIRECTORY="./config/models"

# Models.
# Every MODEL__<name> entry is downloaded into MODEL_DIRECTORY at startup and
# skipped when the file is already there. The local filename is the last path
# segment of the URL. Works for checkpoints, ControlNet, VAE and LoRA alike.
MODEL__SD15="https://huggingface.co/.../v1-5-pruned-emaonly.safetensors"
MODEL__CONTROLNET_CANNY="https://huggingface.co/.../control_canny.safetensors"
# Optional integrity check, matched by declaration name:
MODEL_SHA256__SD15="<sha256sum>"

# Engine tuning.
# Complete sd-server argument line. Add --backend / --params-backend here to
# place the diffusion, text-encoder and VAE stages on specific devices.
ENGINE_ARGS="-m /models/model.gguf --listen-ip 0.0.0.0 --listen-port 8080 --vae-tiling"
