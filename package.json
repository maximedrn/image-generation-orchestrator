{
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-bun": "0.91.2",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-fastify": "11.1.29",
    "effect": "3.22.1",
    "fastify": "5.11.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "name": "stable-diffusion-platform",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target bun --external class-transformer --external class-validator --external @fastify/view --external @fastify/static --external @fastify/cors --external @fastify/middie --external @nestjs/microservices --external @nestjs/platform-express --external @nestjs/websockets --external @nestjs/platform-socket.io --external express --external body-parser",
    "build:musl": "bun run scripts/build-executable.script.ts",
    "dev": "bun --watch src/main.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "nest:init": "bunx @nestjs/cli@11.0.24 new stable-diffusion-platform --package-manager npm --strict --skip-git --skip-install",
    "start": "bun src/main.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run architecture:audit && bun run policy && bun run test",
    "policy": "bun run scripts/project-policy.script.ts",
    "architecture:audit": "bun run scripts/architecture-audit.script.ts"
  },
  "trustedDependencies": [],
  "type": "module",
  "version": "1.0.0"
}
