{
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-bun": "0.91.2",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.1",
    "fastify": "5.12.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@nestjs/testing": "11.2.1",
    "@types/bun": "1.3.14",
    "cspell": "10.0.1",
    "drizzle-kit": "0.31.10",
    "lefthook": "2.1.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "name": "image-generation-orchestrator",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "bun build.ts",
    "database:generate": "drizzle-kit generate",
    "dev": "bun --env-file=.env --watch src/main.ts",
    "docs": "bunx typedoc@0.28.20",
    "docs:serve": "bun run docs && bunx serve@14.2.6 docs/api --listen 3001",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --write .",
    "lint:check": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "prepare": "lefthook install",
    "scaffold": "bunx @nestjs/cli generate",
    "spell": "cspell \"**\" --no-progress",
    "spell:words": "cspell \"**\" --no-progress --unique --words-only",
    "start": "bun --env-file=.env src/main.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run lint:check && bun run spell && bun run typecheck && bun run test:coverage"
  },
  "trustedDependencies": [],
  "type": "module",
  "version": "1.0.0"
}
